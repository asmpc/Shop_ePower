# ======================================================
# Media
# ======================================================

# По умолчанию пользовательские загрузки не храним в Git
src/media/*

# Оставляем демонстрационные изображения каталога
!src/media/products/
!src/media/brands/
!src/media/categories/

# Тестовые изображения каталога не храним
src/media/products/test*
src/media/brands/test*
src/media/categories/test*

# Вложения чата являются пользовательскими данными
src/media/chat/


